{
  "name": "docket",
  "version": "0.2.0",
  "description": "Open-source Second Brain Core — ingest, embed, query",
  "main": "src/platform/unified/index.js",
  "bin": {
    "docket": "src/cli/index.js",
    "docket-mcp-data": "bin/mcp-data.js"
  },
  "scripts": {
    "start": "node src/platform/unified/bin.js",
    "start:control": "node src/platform/control/bin.js",
    "start:data": "node src/platform/data/bin.js",
    "dev": "nodemon src/platform/unified/bin.js",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e --runInBand",
    "test:coverage": "jest --coverage --coverageReporters=text-summary",
    "test:ci": "npm run lint && npm run test:unit -- --coverage && npm run docs:check",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "setup": "node src/scripts/setup.js",
    "migrate": "node src/scripts/migrate.js",
    "doctor": "node src/scripts/doctor.js",
    "docs:dev": "npm run -w docs dev",
    "docs:build": "npm run -w docs build",
    "docs:check": "npm run -w docs check",
    "docs:deploy": "npm run -w docs deploy"
  },
  "workspaces": [
    "src/adapters/*/*",
    "docs"
  ],
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1053.0",
    "@aws-sdk/client-dynamodb": "^3.1053.0",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/client-sqs": "^3.1053.0",
    "@aws-sdk/lib-dynamodb": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1067.0",
    "@fastify/multipart": "^8.0.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "fastify": "^4.26.0",
    "js-yaml": "^4.1.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "sqlite-vec": "^0.1.9",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "supertest": "^6.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "src/",
    "bin/",
    "config/",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/revanth0212/docket.git"
  },
  "keywords": [
    "second-brain",
    "knowledge-management",
    "rag",
    "llm",
    "open-source",
    "vector-search"
  ]
}
